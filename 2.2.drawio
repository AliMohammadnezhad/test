<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="class_diagram" name="Class Diagram">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- User Class -->
        <mxCell id="2" value="User&#xa;- userId: String&#xa;- name: String&#xa;- email: String&#xa;- password: String&#xa;- role: Enum (Student, Instructor, Admin)&#xa;- phone: String" style="swimlane;rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="160" height="140" as="geometry" />
        </mxCell>
        
        <!-- Instructor (inherits from User or association) -->
        <mxCell id="3" value="Instructor&#xa;- instructorId: String&#xa;- bio: String&#xa;- expertise: String&#xa;- availability: String" style="swimlane;rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="240" y="80" width="160" height="120" as="geometry" />
        </mxCell>
        
        <!-- Course Class -->
        <mxCell id="4" value="Course&#xa;- courseId: String&#xa;- title: String&#xa;- description: String&#xa;- duration: Integer&#xa;- price: Double&#xa;- prerequisites: List&lt;Course&gt;&#xa;- capacity: Integer&#xa;- category: String (Language, Skill, etc.)" style="swimlane;rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="180" height="160" as="geometry" />
        </mxCell>
        
        <!-- Class/Session -->
        <mxCell id="5" value="Class&#xa;- classId: String&#xa;- courseId: String&#xa;- schedule: DateTime&#xa;- location: String (Online/Offline)&#xa;- capacity: Integer&#xa;- currentEnrollment: Integer" style="swimlane;rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="660" y="80" width="160" height="140" as="geometry" />
        </mxCell>
        
        <!-- Enrollment -->
        <mxCell id="6" value="Enrollment&#xa;- enrollmentId: String&#xa;- userId: String&#xa;- classId: String&#xa;- enrollmentDate: Date&#xa;- status: Enum (Active, Completed, Dropped)&#xa;- progress: Float" style="swimlane;rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="160" height="140" as="geometry" />
        </mxCell>
        
        <!-- Exam -->
        <mxCell id="7" value="Exam&#xa;- examId: String&#xa;- classId: String&#xa;- title: String&#xa;- date: DateTime&#xa;- duration: Integer&#xa;- totalScore: Integer" style="swimlane;rounded=0;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="240" y="280" width="160" height="120" as="geometry" />
        </mxCell>
        
        <!-- Payment -->
        <mxCell id="8" value="Payment&#xa;- paymentId: String&#xa;- enrollmentId: String&#xa;- amount: Double&#xa;- paymentDate: Date&#xa;- status: Enum (Paid, Pending, Refunded)&#xa;- method: String" style="swimlane;rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="440" y="280" width="160" height="140" as="geometry" />
        </mxCell>
        
        <!-- Content -->
        <mxCell id="9" value="Content&#xa;- contentId: String&#xa;- courseId: String&#xa;- type: Enum (Video, Document, Quiz)&#xa;- url: String&#xa;- format: String (Online/Offline)" style="swimlane;rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="660" y="280" width="160" height="120" as="geometry" />
        </mxCell>
        
        <!-- Relationships -->
        <!-- User to Enrollment -->
        <mxCell id="10" value="" style="endArrow=block;html=1;rounded=0;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" edge="1" parent="1" source="2" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Instructor to Course or Class -->
        <mxCell id="11" value="teaches 1..*" style="endArrow=block;html=1;rounded=0;entryX=0.5;entryY=1;exitX=0.5;exitY=0;" edge="1" parent="1" source="3" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Course to Class -->
        <mxCell id="12" value="has 1..*" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Class to Enrollment -->
        <mxCell id="13" value="has 0..*" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Class to Exam -->
        <mxCell id="14" value="has 0..*" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="5" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Enrollment to Payment -->
        <mxCell id="15" value="has 0..1" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="6" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Course to Content -->
        <mxCell id="16" value="provides 1..*" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="4" target="9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- User (Instructor role) to Instructor if separate -->
        <!-- Note: For simplicity, Instructor can be a subclass or separate with association -->
        
        <!-- Prerequisites -->
        <mxCell id="17" value="prerequisites" style="endArrow=open;html=1;rounded=0;endSize=12;dashed=1;" edge="1" parent="1" source="4" target="4">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="120" as="sourcePoint" />
            <mxPoint x="620" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>